# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.

# Webhook that receives callback requests from the audit form (for example an n8n Webhook node, production URL).
# While this is empty the callback form stays hidden on the site.
LEAD_WEBHOOK_URL=

# Optional shared secret. Sent to the webhook as the X-Lead-Secret header so it can reject other callers.
LEAD_WEBHOOK_SECRET=
